# ============================================================
#  DASH ASSINATURA — variáveis de ambiente (exemplo)
#  Copie este arquivo para `.env` na raiz de apps/api e preencha.
#  NUNCA commite o arquivo `.env` real.
# ============================================================

# ---- Banco de dados (PostgreSQL) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dash_assinatura?schema=public"

# ---- Backend ----
# Porta do servidor da API
PORT=3333
# Base URL pública usada para montar links de assinatura
PUBLIC_BASE_URL="http://localhost:5173"
# Segredo usado para assinar o cookie de sessão do admin (troque por valor longo e aleatório)
SESSION_SECRET="mude-para-um-segredo-longo-e-aleatorio"

# ---- Login do administrador (MVP: usuário único via env) ----
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="troque-esta-senha"

# ---- Pagamento (gateway plugável) ----
# Provedor ativo. Para desenvolvimento/usar o fluxo completo sem gateway real, use "mock".
# Quando o gateway real for definido, troque por ex. "asaas" | "mercadopago" | "stripe" ...
PAYMENT_PROVIDER="mock"

# Caminho de integração: sandbox | production
PAYMENT_ENVIRONMENT="sandbox"
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# ---- Frontend (apps/web) ----
# Apontado pelo próprio app/.env codificado abaixo; ver apps/web/.env.example